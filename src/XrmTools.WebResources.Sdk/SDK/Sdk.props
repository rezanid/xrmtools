<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.VisualStudio.JavaScript.SDK/1.0.5706140">

	<PropertyGroup>
		<TargetPlatformIdentifier></TargetPlatformIdentifier>
		<TargetPlatformMoniker></TargetPlatformMoniker>
		<TargetPlatformVersion></TargetPlatformVersion>

		<Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

		<ShouldRunBuildScript Condition="'$(ShouldRunBuildScript)' == ''">false</ShouldRunBuildScript>
		<BuildOutputFolder Condition="'$(BuildOutputFolder)' == ''">$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
		<!-- Optional visibility fast-path for Xrm Tools. The SDK identity remains authoritative. -->
		<IsXrmToolsWebResourceProject Condition="'$(IsXrmToolsWebResourceProject)' == ''">true</IsXrmToolsWebResourceProject>

		<!--
			Detect a CI/pipeline build. In CI we prefer a clean, reproducible install ('npm ci'),
			but only when a committed 'package-lock.json' exists (it is required by 'npm ci').
			For local development we default to 'npm install' so changes to package.json are
			picked up automatically without running npm from a terminal.
		-->
		<IsCiBuild Condition="'$(IsCiBuild)' == '' and ('$(ContinuousIntegrationBuild)' == 'true' or '$(CI)' == 'true' or '$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true')">true</IsCiBuild>

		<NpmRestoreCommand Condition="'$(NpmRestoreCommand)' == '' and '$(IsCiBuild)' == 'true' and Exists('$(MSBuildProjectDirectory)\package-lock.json')">npm ci</NpmRestoreCommand>
		<NpmRestoreCommand Condition="'$(NpmRestoreCommand)' == ''">npm install</NpmRestoreCommand>
		<NpmRestoreStampFile Condition="'$(NpmRestoreStampFile)' == ''">$(MSBuildProjectDirectory)\node_modules\.xrmtools-restore.stamp</NpmRestoreStampFile>
		<NpmCleanCommand Condition="'$(NpmCleanCommand)' == ''">npm run clean</NpmCleanCommand>

		<NpmBuildCommand Condition="'$(NpmBuildCommand)' == '' and '$(Configuration)' == 'Debug'">npm run build:debug</NpmBuildCommand>
		<NpmBuildCommand Condition="'$(NpmBuildCommand)' == '' and '$(Configuration)' != 'Debug'">npm run build:release</NpmBuildCommand>
	</PropertyGroup>

	<ItemGroup>
		<_XrmToolsNpmRestoreInput Include="$(MSBuildProjectDirectory)\package.json" />
		<_XrmToolsNpmRestoreInput Include="$(MSBuildProjectDirectory)\package-lock.json"
			Condition="Exists('$(MSBuildProjectDirectory)\package-lock.json')" />
	</ItemGroup>

	<!--
		Registration consumes these evaluated items after a successful build. Projects may use
		WebResource Update="..." to override Name, DisplayName, Description, or WebResourceType.
	-->
	<ItemGroup>
		<WebResource Include="$(BuildOutputFolder)\**\*.html;$(BuildOutputFolder)\**\*.htm;$(BuildOutputFolder)\**\*.css;$(BuildOutputFolder)\**\*.js;$(BuildOutputFolder)\**\*.xml;$(BuildOutputFolder)\**\*.png;$(BuildOutputFolder)\**\*.jpg;$(BuildOutputFolder)\**\*.jpeg;$(BuildOutputFolder)\**\*.gif;$(BuildOutputFolder)\**\*.xap;$(BuildOutputFolder)\**\*.xsl;$(BuildOutputFolder)\**\*.xslt;$(BuildOutputFolder)\**\*.ico;$(BuildOutputFolder)\**\*.svg;$(BuildOutputFolder)\**\*.resx"
			Condition="Exists('$(BuildOutputFolder)')">
			<Name>$(WebResourceNamePrefix)%(RecursiveDir)%(Filename)%(Extension)</Name>
			<DisplayName>%(Name)</DisplayName>
		</WebResource>
	</ItemGroup>

</Project>
