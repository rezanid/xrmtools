<UserControl x:Class="XrmTools.PluginTrace.TraceExplorerControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
 xmlns:c="clr-namespace:XrmTools.Shell.Controls"
 xmlns:s="clr-namespace:XrmTools.Shell.Styles"
 FontFamily="{DynamicResource VsFont.EnvironmentFontFamily}"
 FontSize="{DynamicResource VsFont.EnvironmentFontSize}"
 UseLayoutRounding="True"
 Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
 Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <!-- Same square underline, spacing and theme keys as OData's ViewTabStyle, with native TabItem keyboard semantics. -->
  <Style x:Key="DetailTabStyle" TargetType="c:TabItem">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
   <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="c:TabItem">
      <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
       <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vs:EnvironmentColors.FileTabSelectedBorderBrushKey}}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vs:EnvironmentColors.SystemHighlightBrushKey}}"/>
        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="c:Button"><Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="8,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="c:ComboBox"><Setter Property="Margin" Value="4,2,8,2"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="c:CheckBox"><Setter Property="Margin" Value="4,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="DetailText" TargetType="c:TextBox">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="AcceptsReturn" Value="True"/>
   <Setter Property="FontFamily" Value="Consolas"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Background" Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="6"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="6">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="2,0,2,4">
   <WrapPanel DockPanel.Dock="Right">
    <TextBlock Text="Trace logging"/>
    <c:ComboBox x:Name="TraceLogging" Width="130" ItemsSource="{Binding Logging.AvailableOptions}" DisplayMemberPath="Label" SelectedItem="{Binding Logging.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding Logging.IsAvailable}" ToolTip="Dataverse plug-in trace logging level"/>
    <TextBlock x:Name="TraceLoggingTimer" Text="{Binding Logging.TimerText}" Visibility="{Binding Logging.HasTimer, Converter={StaticResource BoolVisibility}}" Margin="0,0,6,0" Foreground="{DynamicResource {x:Static s:ShellColors.TextFillSecondaryBrushKey}}" ToolTip="{Binding Logging.TimerToolTip}"/>
    <c:CheckBox x:Name="AutoRefresh" Content="{Binding Logging.AutoRefreshLabel}" IsChecked="{Binding Logging.AutoRefresh}" ToolTip="{Binding Logging.AutoRefreshToolTip}"/>
    <c:ComboBox x:Name="Interval" SelectedValuePath="Tag" SelectedValue="{Binding IntervalSeconds}" Width="84" ToolTip="Refresh interval"><c:ComboBoxItem Content="5 sec" Tag="5"/><c:ComboBoxItem Content="10 sec" Tag="10"/><c:ComboBoxItem Content="30 sec" Tag="30"/><c:ComboBoxItem Content="60 sec" Tag="60"/></c:ComboBox>
   </WrapPanel>
   <TextBlock x:Name="EnvironmentLabel" Text="{Binding EnvironmentLabel}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static s:ShellColors.TextFillSecondaryBrushKey}}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </DockPanel>
  <StackPanel Grid.Row="1">
   <WrapPanel>
    <c:DropDownButton x:Name="SavedViewsButton" Content="{Binding SavedViewLabel}" Margin="0,0,8,0" ToolTip="Select, save, or delete a saved filter">
     <c:DropDownButton.DropDown>
      <c:Popup x:Name="SavedViewsPopup" Placement="Bottom" FocusOnOpen="True">
       <Border Padding="4" MinWidth="260" Background="{DynamicResource {x:Static s:ShellColors.ControlFillDefaultBrushKey}}" BorderBrush="{DynamicResource {x:Static s:ShellColors.ControlStrokeDefaultBrushKey}}" BorderThickness="1">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="Saved views" Margin="4,2" Foreground="{DynamicResource {x:Static s:ShellColors.TextFillSecondaryBrushKey}}"/>
         <c:ListBox x:Name="SavedViews" Grid.Row="1" ItemsSource="{Binding SavedViews, NotifyOnTargetUpdated=True}" SelectedItem="{Binding SelectedView, Mode=OneWay}" TargetUpdated="SavedViewsSourceUpdated" DisplayMemberPath="Name" SelectionChanged="SavedViewChanged"/>
         <Separator Grid.Row="2" Margin="4"/>
         <WrapPanel Grid.Row="3" Margin="2">
          <c:TextBox x:Name="ViewName" Text="{Binding Filter.Name, UpdateSourceTrigger=PropertyChanged}" Width="145" Margin="0,0,4,0" HintText="View name" ToolTip="Change the name to create a renamed view"/>
          <c:Button Content="Save" Command="{Binding SaveViewCommand}" Click="SavedViewActionClick" ToolTip="Save the selected view, or use a new name to create a view"/>
          <c:Button Content="Delete" Command="{Binding DeleteViewCommand}" Click="SavedViewActionClick" ToolTip="Delete the selected view"/>
         </WrapPanel>
        </Grid>
       </Border>
      </c:Popup>
     </c:DropDownButton.DropDown>
    </c:DropDownButton>
   <WrapPanel x:Name="QuickFilters">
    <TextBlock Text="Time"/>
    <c:ComboBox x:Name="Duration" Width="145" SelectedValuePath="Tag" SelectedValue="{Binding Filter.Minutes}" IsEnabled="{Binding Filter.QuickFiltersEnabled}">
     <c:ComboBoxItem Content="Last 5 minutes" Tag="5"/><c:ComboBoxItem Content="Last 15 minutes" Tag="15"/><c:ComboBoxItem Content="Last 30 minutes" Tag="30"/><c:ComboBoxItem Content="Last hour" Tag="60"/><c:ComboBoxItem Content="Last 24 hours" Tag="1440"/><c:ComboBoxItem Content="Custom range" Tag="0"/>
    </c:ComboBox>
    <TextBlock Text="Type contains"/>
    <c:ComboBox x:Name="TypeName" Text="{Binding Filter.TypeName, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="TypeSuggestionsFocusChanged" DropDownClosed="TypeSuggestionsDropDownClosed" IsEnabled="{Binding Filter.QuickFiltersEnabled}" IsEditable="True" IsTextSearchEnabled="False" Width="240" ToolTip="Plugin type name. Enter all or part of the name; suggestions come from loaded traces."/>
    <c:CheckBox x:Name="ErrorsOnly" Content="Errors only" IsChecked="{Binding Filter.ErrorsOnly}" IsEnabled="{Binding Filter.QuickFiltersEnabled}"/>
    <c:Button x:Name="QueryButton" Content="{Binding QueryLabel}" Command="{Binding RunCommand}" ToolTip="{Binding QueryToolTip}"><c:Button.Style><Style TargetType="c:Button" BasedOn="{StaticResource {x:Type c:Button}}"><Setter Property="Kind" Value="Accent"/><Style.Triggers><DataTrigger Binding="{Binding IsQuerying}" Value="True"><Setter Property="Kind" Value="Standard"/></DataTrigger></Style.Triggers></Style></c:Button.Style></c:Button>
   </WrapPanel>
    <TextBlock x:Name="ModifiedLabel" Text="{Binding ModifiedLabel}" Margin="6,0" Foreground="{DynamicResource {x:Static s:ShellColors.TextFillSecondaryBrushKey}}"/>
   </WrapPanel>
   <WrapPanel x:Name="CustomRange" Visibility="{Binding Filter.ShowCustomRange, Converter={StaticResource BoolVisibility}}" Margin="0,4">
    <TextBlock Text="From (local)"/><c:TextBox x:Name="FromTime" Text="{Binding Filter.FromText, UpdateSourceTrigger=PropertyChanged}" Width="175" Margin="4" ToolTip="yyyy-MM-dd HH:mm:ss"/>
    <TextBlock Text="To (local)"/><c:TextBox x:Name="ToTime" Text="{Binding Filter.ToText, UpdateSourceTrigger=PropertyChanged}" Width="175" Margin="4" ToolTip="yyyy-MM-dd HH:mm:ss"/>
   </WrapPanel>
   <c:Expander Header="Advanced OData filter" Margin="0,0,0,2">
    <StackPanel Margin="20,4,0,4">
     <c:CheckBox x:Name="FullControl" Content="Edit entire $filter — replaces time, type, and error filters" IsChecked="{Binding Filter.FullControl}"/>
     <c:TextBox x:Name="Expression" Text="{Binding Filter.Expression, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" MaxHeight="110" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HintText="Additional OData condition, e.g. performanceexecutionduration gt 1000"/>
     <TextBlock Text="Effective filter" ToolTip="Relative time is recalculated on each refresh." Margin="2,6,2,2"/>
     <c:TextBox x:Name="Preview" Text="{Binding Filter.Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" MaxHeight="42" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </StackPanel>
   </c:Expander>
  </StackPanel>
  <DockPanel Grid.Row="2"><c:Button x:Name="BackButton" Content="Back to results" Visibility="{Binding CanGoBack, Converter={StaticResource BoolVisibility}}" Command="{Binding BackCommand}" DockPanel.Dock="Left"/></DockPanel>
   <Grid Grid.Row="3" Margin="0,4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition x:Name="SplitterColumn" Width="0"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid>
    <c:DataGrid x:Name="Logs" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.ScrollUnit="Item" SelectionChanged="LogSelected" Sorting="LogsSorting">
     <c:DataGrid.RowStyle>
      <Style TargetType="c:DataGridRow">
       <Setter Property="ContextMenu">
        <Setter.Value>
         <c:ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <c:MenuItem Header="Go To Definition" InputGestureText="F12" Click="GoToDefinitionClick"/>
         </c:ContextMenu>
        </Setter.Value>
       </Setter>
      </Style>
     </c:DataGrid.RowStyle>
     <c:DataGrid.Columns>
      <c:DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="95"/>
      <c:DataGridTextColumn Header="Created (local)" Binding="{Binding Time}" SortMemberPath="CreatedOn" Width="180"/>
      <c:DataGridTextColumn Header="Type name" Binding="{Binding ShortTypeName}" SortMemberPath="TypeName" Width="2*" MinWidth="180">
       <c:DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding TypeName}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></c:DataGridTextColumn.ElementStyle>
      </c:DataGridTextColumn>
      <c:DataGridTextColumn Header="Message" Binding="{Binding MessageName}" SortMemberPath="MessageName" Width="120"/>
      <c:DataGridTextColumn Header="Entity" Binding="{Binding Entity}" SortMemberPath="Entity" Width="110"/>
      <c:DataGridTextColumn Header="Duration (ms)" Binding="{Binding Duration}" SortMemberPath="Duration" Width="110"/>
      <c:DataGridTextColumn Header="Depth" Binding="{Binding Depth}" SortMemberPath="Depth" Width="70"/>
     </c:DataGrid.Columns>
    </c:DataGrid>
    <StackPanel x:Name="EmptyState" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" MaxWidth="600">
     <TextBlock x:Name="EmptyStateMessage" Text="{Binding EmptyMessage}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock Text="Try a longer time window, clear filters, or refresh." HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4" Foreground="{DynamicResource {x:Static s:ShellColors.TextFillSecondaryBrushKey}}"/>
     <WrapPanel HorizontalAlignment="Center"><c:Button Content="Last 24 hours" Command="{Binding Last24HoursCommand}"/><c:Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"/></WrapPanel>
    </StackPanel>
   </Grid>
   <GridSplitter x:Name="DetailSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Visibility="{Binding Detail.IsOpen, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource {x:Static s:ShellColors.ControlStrokeDefaultBrushKey}}"/>
   <Grid x:Name="Details" Grid.Column="2" Visibility="{Binding Detail.IsOpen, Converter={StaticResource BoolVisibility}}" Margin="6,0,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel>
     <c:Button x:Name="CloseDetailsButton" Content="✕" Width="24" Height="24" Padding="0" Kind="Subtle" ToolTip="Close details (Esc)" AutomationProperties.Name="Close details" DockPanel.Dock="Right" Command="{Binding CloseDetailCommand}"/>
     <TextBlock x:Name="DetailTitle" Text="{Binding Detail.Title}" ToolTip="{Binding Detail.TypeName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <StackPanel Grid.Row="1">
     <TextBlock x:Name="DetailSummary" Text="{Binding Detail.Summary}" TextWrapping="Wrap" Margin="3,2,3,4" Foreground="{DynamicResource {x:Static s:ShellColors.TextFillSecondaryBrushKey}}"/>
     <TextBlock x:Name="DetailNotice" Text="{Binding Detail.Notice}" TextWrapping="Wrap" Margin="3,2" Visibility="{Binding Detail.HasNotice, Converter={StaticResource BoolVisibility}}"/>
     <WrapPanel>
      <c:Button x:Name="RelatedButton" Content="Show related execution" Click="RelatedClick" IsEnabled="{Binding Detail.CanShowRelated}"/>
      <c:Button x:Name="UpdateDetailButton" Content="Load updated trace" Visibility="{Binding Detail.CanUpdate, Converter={StaticResource BoolVisibility}}" Command="{Binding UpdateDetailCommand}"/>
     </WrapPanel>
     <WrapPanel Margin="2,3">
      <c:TextBox x:Name="FindText" Width="170" HintText="Find in current tab" ToolTip="Search the active detail tab"/>
      <c:Button Content="Find next" Click="FindNextClick"/>
      <c:CheckBox x:Name="WrapText" Content="Wrap" IsChecked="True" Click="WrapClick"/>
      <TextBlock x:Name="FindStatus"/>
     </WrapPanel>
    </StackPanel>
    <c:TabControl x:Name="DetailTabs" SelectedIndex="{Binding Detail.PreferredTab, Mode=OneWay}" Grid.Row="2" ItemContainerStyle="{StaticResource DetailTabStyle}">
     <c:TabItem x:Name="ExceptionTab" Header="Exception" Visibility="{Binding Detail.HasException, Converter={StaticResource BoolVisibility}}"><c:TextBox x:Name="ExceptionText" Text="{Binding Detail.Exception, Mode=OneWay}" Style="{StaticResource DetailText}"/></c:TabItem>
     <c:TabItem Header="Trace message"><c:TextBox x:Name="MessageText" Text="{Binding Detail.Message, Mode=OneWay}" Style="{StaticResource DetailText}"/></c:TabItem>
     <c:TabItem Header="Full record"><c:ReadOnlyCodeView x:Name="RawText" Text="{Binding Detail.Raw}" ContentType="JSON" TextWrapping="Wrap"/></c:TabItem>
    </c:TabControl>
   </Grid>
  </Grid>
   <TextBlock Grid.Row="4" x:Name="Status" Text="{Binding Status}" TextWrapping="Wrap" Margin="3"/>
 </Grid>
</UserControl>
