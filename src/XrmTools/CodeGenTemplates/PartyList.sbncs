{{~prop_name = attribute.schema_name ~}}
{{~party_type = 'Microsoft.Xrm.Sdk.Entity'
for entity_config in model.entities
    if entity_config.logical_name == 'activityparty'
        for party_definition in model.entity_definitions
            if party_definition.logical_name == 'activityparty'
                party_namespace = first_plugin_type?.namespace ?? config.default_namespace
                party_type = 'global::' + (party_namespace.empty? ? '' : party_namespace + '.') + party_definition.schema_name
                break
            end
        end
        break
    end
end~}}
[AttributeLogicalName("{{attribute.logical_name}}")]
public IEnumerable<{{party_type}}> {{prop_name}}
{
	{{~if attribute.is_valid_for_read~}}
	get => TryGetAttributeValue("{{attribute.logical_name}}", out EntityCollection value) && value != null
		? value.Entities.Select(party => party.ToEntity<{{party_type}}>())
		: null;
	{{~end~}}
	{{~if !force_readonly && (attribute.is_valid_for_create || attribute.is_valid_for_update)~}}
	set => this["{{attribute.logical_name}}"] = value == null ? null : new EntityCollection(value.Cast<Entity>().ToList());
