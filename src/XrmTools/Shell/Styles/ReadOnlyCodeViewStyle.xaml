<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:XrmTools.Shell.Controls"
                    xmlns:s="clr-namespace:XrmTools.Shell.Styles">
 <Style TargetType="c:ReadOnlyCodeView">
  <Setter Property="Foreground" Value="{DynamicResource {x:Static s:ShellColors.TextFillPrimaryBrushKey}}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="c:ReadOnlyCodeView">
     <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
      <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
</ResourceDictionary>
