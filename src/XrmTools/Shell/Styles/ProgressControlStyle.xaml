<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrls="clr-namespace:XrmTools.Shell.Controls"
                    xmlns:cvrts="clr-namespace:XrmTools.Shell.Converters"
                    xmlns:styles="clr-namespace:XrmTools.Shell.Styles">
  <cvrts:RingGeometryConverter x:Key="RingGeometryConverter"/>

  <ControlTemplate x:Key="BarTemplate" TargetType="{x:Type ctrls:ProgressControl}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border x:Name="Track" Grid.Row="0"
              Background="{DynamicResource {x:Static styles:ShellColors.ControlStrongFillDefaultBrushKey}}"
              Height="1" VerticalAlignment="Center" Width="{TemplateBinding FrameworkElement.Width}"/>
      <Border x:Name="PART_Indicator" Grid.Row="0" Background="{TemplateBinding Control.Background}"
              Height="{x:Static ctrls:Indicator.ControlWidth}" HorizontalAlignment="Left"
              RenderTransformOrigin="0,0.5" RenderTransform="{x:Null}"
              CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static cvrts:Converters.MultiplyConverter}, ConverterParameter=0.5}"/>
      <ctrls:TextBlock x:Name="Message" Grid.Row="1"
                       HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                       Margin="{TemplateBinding Control.Padding}" MinHeight="{x:Static styles:Sizes.ContentMinHeight}"
                       Text="{TemplateBinding ctrls:ProgressControl.Message}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="ctrls:ProgressControl.Message" Value="{x:Null}">
        <Setter TargetName="Message" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="ctrls:ProgressControl.Message" Value="">
        <Setter TargetName="Message" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="ctrls:ProgressControl.Kind" Value="BarDeterminate">
        <Setter TargetName="PART_Indicator" Property="FrameworkElement.Width">
          <Setter.Value>
            <MultiBinding Converter="{x:Static cvrts:Converters.MultiplyConverter}">
              <Binding Path="ActualWidth" ElementName="Track"/>
              <Binding Path="Progress" RelativeSource="{RelativeSource TemplatedParent}"/>
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="ctrls:ProgressControl.Kind" Value="BarIndeterminate">
        <Setter TargetName="PART_Indicator"
                Property="FrameworkElement.Width"
                Value="{Binding ActualWidth, ElementName=Track, Converter={x:Static cvrts:Converters.MultiplyConverter}, ConverterParameter=0.25}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="RingTemplate" TargetType="{x:Type ctrls:ProgressControl}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="PART_Indicator"
              Height="{TemplateBinding ctrls:ProgressControl.RingDiameter}"
              Width="{TemplateBinding ctrls:ProgressControl.RingDiameter}"
              RenderTransformOrigin="0.5,0.5"
              VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
              RenderTransform="{x:Null}">
        <Path x:Name="Ring" Stroke="{TemplateBinding Control.Background}"
              StrokeThickness="{x:Static styles:StrokeWidths.PrimitiveThick}"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Top"/>
      </Border>
      <ctrls:TextBlock x:Name="Message" Grid.Column="1" Margin="{TemplateBinding Control.Padding}"
                       MinHeight="{x:Static styles:Sizes.ContentMinHeight}"
                       Text="{TemplateBinding ctrls:ProgressControl.Message}" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="ctrls:ProgressControl.Message" Value="{x:Null}">
        <Setter TargetName="Message" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="ctrls:ProgressControl.Message" Value="">
        <Setter TargetName="Message" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="ctrls:ProgressControl.Kind" Value="RingDeterminate">
        <Setter TargetName="Ring" Property="Path.Data">
          <Setter.Value>
            <MultiBinding Converter="{StaticResource RingGeometryConverter}">
              <Binding Path="Progress" RelativeSource="{RelativeSource TemplatedParent}"/>
              <Binding Path="RingDiameter" RelativeSource="{RelativeSource TemplatedParent}"/>
              <Binding Path="StrokeThickness" ElementName="Ring"/>
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="ctrls:ProgressControl.Kind" Value="RingIndeterminate">
        <Setter TargetName="Ring" Property="Path.Data">
          <Setter.Value>
            <MultiBinding Converter="{StaticResource RingGeometryConverter}">
              <Binding Source="{x:Static cvrts:RingGeometryConverter.IndeterminateProgress}"/>
              <Binding Path="RingDiameter" RelativeSource="{RelativeSource TemplatedParent}"/>
              <Binding Path="StrokeThickness" ElementName="Ring"/>
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="{x:Type ctrls:ProgressControl}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {x:Static styles:ShellColors.AccentFillDefaultBrushKey}}"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ctrls:ProgressControl.RingDiameter" Value="{x:Static styles:Sizes.IconS}"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="FrameworkElement.UseLayoutRounding" Value="True"/>
    <Setter Property="UIElement.Clip">
      <Setter.Value>
        <MultiBinding Converter="{x:Static cvrts:Converters.ClipConverter}">
          <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
          <Binding Source="{x:Static styles:CornerRadii.None}"/>
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ctrls:ProgressControl.Kind" Value="BarDeterminate">
        <Setter Property="Control.HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Control.Padding" Value="{x:Static styles:Spacings.XS}"/>
        <Setter Property="Control.Template" Value="{StaticResource BarTemplate}"/>
      </Trigger>
      <Trigger Property="ctrls:ProgressControl.Kind" Value="BarIndeterminate">
        <Setter Property="Control.HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Control.Padding" Value="{x:Static styles:Spacings.XS}"/>
        <Setter Property="Control.Template" Value="{StaticResource BarTemplate}"/>
      </Trigger>
      <Trigger Property="ctrls:ProgressControl.Kind" Value="RingDeterminate">
        <Setter Property="Control.Padding" Value="{x:Static styles:Spacings.HorizontalS}"/>
        <Setter Property="Control.Template" Value="{StaticResource RingTemplate}"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
      </Trigger>
      <Trigger Property="ctrls:ProgressControl.Kind" Value="RingIndeterminate">
        <Setter Property="Control.Padding" Value="{x:Static styles:Spacings.HorizontalS}"/>
        <Setter Property="Control.Template" Value="{StaticResource RingTemplate}"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
