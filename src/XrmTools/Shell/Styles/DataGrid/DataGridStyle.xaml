<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrls="clr-namespace:XrmTools.Shell.Controls"
                    xmlns:styles="clr-namespace:XrmTools.Shell.Styles">
  <ControlTemplate x:Key="DataGridScrollViewerTemplate" TargetType="{x:Type ctrls:ScrollViewer}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PresenterColumn" Width="*"/>
        <ColumnDefinition x:Name="ScrollBarColumn" Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="HeaderRow" Height="Auto"/>
        <RowDefinition x:Name="PresenterRow" Height="*"/>
        <RowDefinition x:Name="ScrollBarRow" Height="Auto"/>
      </Grid.RowDefinitions>
      <ctrls:DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"/>
      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="1"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                              Margin="{TemplateBinding Control.Padding}"
                              VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"/>
      <ctrls:ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                       HorizontalAlignment="Right" Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}"
                       Orientation="Vertical" Value="{TemplateBinding ScrollViewer.VerticalOffset}"
                       ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}"
                       Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}"/>
      <ctrls:ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
                       Maximum="{TemplateBinding ScrollViewer.ScrollableWidth}" Orientation="Horizontal"
                       Value="{TemplateBinding ScrollViewer.HorizontalOffset}" VerticalAlignment="Bottom"
                       ViewportSize="{TemplateBinding ScrollViewer.ViewportWidth}"
                       Visibility="{TemplateBinding ScrollViewer.ComputedHorizontalScrollBarVisibility}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="ScrollViewer.ComputedHorizontalScrollBarVisibility" Value="Visible">
        <Setter TargetName="ScrollBarRow" Value="{x:Static ctrls:ScrollViewer.ScrollBarReservedSize}" Property="RowDefinition.MinHeight"/>
      </Trigger>
      <Trigger Property="ScrollViewer.ComputedVerticalScrollBarVisibility" Value="Visible">
        <Setter TargetName="ScrollBarColumn" Value="{x:Static ctrls:ScrollViewer.ScrollBarReservedSize}" Property="ColumnDefinition.MinWidth"/>
      </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AreDynamicScrollBarsEnabled, Source={x:Static styles:VisualOptions.Instance}}" Value="False"/>
          <Condition Binding="{Binding ComputedHorizontalScrollBarVisibility, RelativeSource={RelativeSource Self}}" Value="Visible"/>
        </MultiDataTrigger.Conditions>
        <Setter TargetName="ScrollBarRow" Value="{Binding SystemHorizontalScrollBarHeight, Source={x:Static styles:VisualOptions.Instance}}"
                Property="RowDefinition.MinHeight"/>
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding AreDynamicScrollBarsEnabled, Source={x:Static styles:VisualOptions.Instance}}" Value="False"/>
          <Condition Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}" Value="Visible"/>
        </MultiDataTrigger.Conditions>
        <Setter TargetName="ScrollBarColumn" Value="{Binding SystemVerticalScrollBarWidth, Source={x:Static styles:VisualOptions.Instance}}"
                Property="ColumnDefinition.MinWidth"/>
      </MultiDataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="{x:Type ctrls:DataGrid}">
    <Setter Property="Control.Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlFillTransparentBrushKey}}"/>
    <Setter Property="Control.BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrokeDefaultBrushKey}}"/>
    <Setter Property="Control.BorderThickness" Value="{x:Static styles:StrokeWidths.Thin}"/>
    <Setter Property="DataGrid.EnableColumnVirtualization" Value="True"/>
    <Setter Property="DataGrid.EnableRowVirtualization" Value="True"/>
    <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrokeDefaultBrushKey}}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="FrameworkElement.UseLayoutRounding" Value="True"/>
    <Setter Property="DataGrid.VerticalGridLinesBrush" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrokeDefaultBrushKey}}"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:DataGrid}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}">
            <ctrls:ScrollViewer Template="{StaticResource DataGridScrollViewerTemplate}">
              <ItemsPresenter/>
            </ctrls:ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ItemsControl.IsGrouping" Value="True">
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
