<ctrls:DialogWindow x:Class="XrmTools.UI.EnvironmentEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrls="clr-namespace:XrmTools.Shell.Controls"
    xmlns:styles="clr-namespace:XrmTools.Shell.Styles"
    xmlns:p="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:XrmTools.UI"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:EnvironmentEditorViewModel, IsDesignTimeCreatable=True}"
    Title="Manage environments" Width="940" Height="740" MinWidth="760" MinHeight="540"
    ResizeMode="CanResize" SizeToContent="Manual" Padding="24,16,24,20"
    IsCloseButtonEnabled="{Binding IsIdle}" p:FocusHelper.FocusTarget="{Binding ElementName=NameTextBox}">
    <ctrls:DialogWindow.InputBindings>
        <KeyBinding Modifiers="Alt" Key="A" Command="{Binding AddEnvironmentCommand}"/>
        <KeyBinding Modifiers="Alt" Key="R" Command="{Binding RemoveEnvironmentCommand}"/>
        <KeyBinding Modifiers="Alt" Key="V" Command="{Binding SetActiveEnvironmentCommand}" CommandParameter="{Binding SelectedEnvironment}"/>
    </ctrls:DialogWindow.InputBindings>
    <ctrls:DialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ListAction" TargetType="ctrls:PathButton" BasedOn="{x:Static styles:ShellInternalStyles.PathButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Kind" Value="Subtle"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static p:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </ctrls:DialogWindow.Resources>
    <ctrls:DialogWindow.FooterContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ctrls:TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"
                             AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ctrls:Button Content="_Save" Kind="Accent" MinWidth="96" IsDefault="True" Command="{Binding SaveCommand}"
                              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ctrls:DialogWindow}}"/>
                <ctrls:Button Content="_Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}"
                              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ctrls:DialogWindow}}"/>
            </StackPanel>
        </Grid>
    </ctrls:DialogWindow.FooterContent>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <ctrls:TextBlock TextWrapping="Wrap" Opacity="0.8">
                <Run Text="Saved in: "/><Run Text="{Binding ActiveEnvironmentScopeName, Mode=OneWay}"/>
            </ctrls:TextBlock>
        </StackPanel>
        <Grid Grid.Row="1" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Height="32" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ctrls:TextBlock Text="Environments" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="Environment actions">
                        <ctrls:PathButton x:Name="AddEnvironmentButton" Style="{StaticResource ListAction}"
                            Data="M7.5,3 L8.5,3 8.5,7.5 13,7.5 13,8.5 8.5,8.5 8.5,13 7.5,13 7.5,8.5 3,8.5 3,7.5 7.5,7.5 Z"
                            Command="{Binding AddEnvironmentCommand}" ToolTip="Add environment (Alt+A)"
                            AutomationProperties.Name="Add environment" AutomationProperties.AcceleratorKey="Alt+A"/>
                        <ctrls:PathButton x:Name="RemoveEnvironmentButton" Style="{StaticResource ListAction}"
                            Data="M3,7.5 L13,7.5 13,8.5 3,8.5 Z"
                            Command="{Binding RemoveEnvironmentCommand}" ToolTip="Remove selected environment (Alt+R). Changes are applied when you save."
                            AutomationProperties.Name="Remove selected environment" AutomationProperties.AcceleratorKey="Alt+R"/>
                        <ctrls:PathButton x:Name="SetActiveEnvironmentButton" Style="{StaticResource ListAction}" Data="{x:Static styles:Geometries.CheckBoxCheckmark}"
                            Command="{Binding SetActiveEnvironmentCommand}" CommandParameter="{Binding SelectedEnvironment}"
                            ToolTip="Set selected environment as active (Alt+V). Changes are applied when you save."
                            AutomationProperties.Name="Set selected environment as active" AutomationProperties.AcceleratorKey="Alt+V"/>
                    </StackPanel>
                </Grid>
                <ctrls:ListBox Grid.Row="1" x:Name="EnvironmentsListBox" ItemsSource="{Binding Environments}"
                               SelectedItem="{Binding SelectedEnvironment}" HorizontalContentAlignment="Stretch"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Environments">
                    <ctrls:ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <DockPanel MinHeight="20">
                                    <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                            BorderThickness="1" BorderBrush="{DynamicResource {x:Static styles:ShellColors.ControlStrokeDefaultBrushKey}}"
                                            Visibility="{Binding IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ctrls:TextBlock Text="Active" Kind="Caption"/>
                                    </Border>
                                    <ctrls:TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                </DockPanel>
                                <ctrls:TextBlock Text="{Binding EnvironmentUrl}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Opacity="0.75" ToolTip="{Binding EnvironmentUrl}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ctrls:ListBox.ItemTemplate>
                </ctrls:ListBox>
            </Grid>
            <Border Grid.Column="1" Width="1" Background="{DynamicResource {x:Static p:EnvironmentColors.ToolWindowBorderBrushKey}}"/>
            <Grid Grid.Column="2">
                <ctrls:TextBlock Text="Add an environment to configure its connection." TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ctrls:TextBlock.Style>
                        <Style TargetType="ctrls:TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedEnvironment}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </ctrls:TextBlock.Style>
                </ctrls:TextBlock>
                <Grid x:Name="ConnectionDetails">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedEnvironment}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ctrls:TextBlock Text="Connection" FontWeight="SemiBold" Height="32" Padding="0,8,0,0" Margin="0,0,0,12"/>
                    <ctrls:ScrollViewer x:Name="ConnectionFields" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0">
                        <Label Content="_Name" Target="{Binding ElementName=NameTextBox}" Style="{StaticResource FieldLabel}"/>
                        <ctrls:TextBox x:Name="NameTextBox" Text="{Binding SelectedEnvironment.Name, UpdateSourceTrigger=PropertyChanged}"
                                       HintText="Environment name" AutomationProperties.Name="Environment name" Margin="0,0,0,16"/>
                        <Label Content="Environment _URL" Target="{Binding ElementName=UrlTextBox}" Style="{StaticResource FieldLabel}"/>
                        <ctrls:TextBox x:Name="UrlTextBox" Text="{Binding SelectedEnvironment.EnvironmentUrl, UpdateSourceTrigger=PropertyChanged}"
                                       HintText="https://yourorg.crm.dynamics.com" AutomationProperties.Name="Environment URL" Margin="0,0,0,16"/>
                        <ctrls:TextBlock Text="Authentication" FontWeight="SemiBold" Margin="0,8,0,12"/>
                        <Label Content="Sign-in _method" Target="{Binding ElementName=AuthenticationType}" Style="{StaticResource FieldLabel}"/>
                        <ctrls:ComboBox x:Name="AuthenticationType" ItemsSource="{Binding AuthTypes}" SelectedItem="{Binding SelectedEnvironment.AuthType, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" AutomationProperties.Name="Authentication type" Margin="0,0,0,16"/>
                        <Label Content="Tenant ID (optional)" Target="{Binding ElementName=TenantId}" Style="{StaticResource FieldLabel}"/>
                        <ctrls:TextBox x:Name="TenantId" Text="{Binding SelectedEnvironment.TenantId, UpdateSourceTrigger=PropertyChanged}"
                                       HintText="Leave empty for auto-discovery" AutomationProperties.Name="Tenant ID" Margin="0,0,0,16"/>
                        <Label Content="Application (client) ID" Target="{Binding ElementName=ClientId}" Style="{StaticResource FieldLabel}"/>
                        <ctrls:TextBox x:Name="ClientId" Text="{Binding SelectedEnvironment.ClientId, UpdateSourceTrigger=PropertyChanged}"
                                       HintText="Leave empty to use the XrmTools application" AutomationProperties.Name="Application client ID"/>
                        <ctrls:TextBlock Margin="0,6,0,16" TextWrapping="Wrap" Opacity="0.75"
                            Visibility="{Binding SelectedEnvironment.IsInteractiveAuth, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Text="Optional. Leave empty to use XrmTools."
                            ToolTip="For a custom Microsoft Entra application, register its Windows Account Manager broker redirect URI."/>
                        <StackPanel Margin="0,12,0,16" Visibility="{Binding SelectedEnvironment.IsClientAuth, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Label Content="Client secret" Target="{Binding ElementName=ClientSecret}" Style="{StaticResource FieldLabel}"/>
                            <ctrls:TextBox x:Name="ClientSecret" Text="{Binding SelectedEnvironment.ClientSecret, UpdateSourceTrigger=PropertyChanged}"
                                           HintText="Client secret" AutomationProperties.Name="Client secret"/>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,16" Visibility="{Binding SelectedEnvironment.IsCertificateAuth, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Label Content="Certificate thumbprint" Target="{Binding ElementName=CertificateThumbprint}" Style="{StaticResource FieldLabel}"/>
                            <ctrls:TextBox x:Name="CertificateThumbprint" Text="{Binding SelectedEnvironment.CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}"
                                           HintText="Certificate thumbprint" AutomationProperties.Name="Certificate thumbprint"/>
                        </StackPanel>
                        <ctrls:Expander Header="Connection string" Margin="0,0,0,16">
                            <StackPanel Margin="0,8,0,0">
                                <ctrls:TextBlock Text="Paste a connection string, or copy the one built from the fields above." TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ctrls:TextBox Text="{Binding SelectedEnvironment.ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                               HintText="Connection string" TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top"
                                               AutomationProperties.Name="Connection string"/>
                            </StackPanel>
                        </ctrls:Expander>
                    </StackPanel>
                    </ctrls:ScrollViewer>
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,12,0"
                            BorderBrush="{DynamicResource {x:Static p:EnvironmentColors.ToolWindowBorderBrushKey}}">
                        <WrapPanel>
                            <ctrls:Button x:Name="TestConnectionButton" Content="_Test connection" Command="{Binding TestConnectionCommand}" Margin="0,0,8,0"/>
                            <ctrls:Button Content="_Disconnect" Command="{Binding ResetSignInCommand}"
                                          ToolTip="Clears this environment's cached token immediately. Your Windows account remains signed in; Cancel does not restore the token."/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ctrls:DialogWindow>
