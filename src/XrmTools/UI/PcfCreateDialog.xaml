<ctrls:DialogWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrls="clr-namespace:XrmTools.Shell.Controls"
    xmlns:p="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    x:Class="XrmTools.UI.PcfCreateDialog" x:ClassModifier="internal"
    Title="Add PCF project" Width="650" Height="650" MinWidth="500" MinHeight="550"
    Padding="24,12" IsCloseButtonEnabled="{Binding IsIdle}">
    <ctrls:DialogWindow.Resources>
        <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource {x:Static p:EnvironmentColors.ToolWindowTextBrushKey}}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </ctrls:DialogWindow.Resources>
    <ctrls:DialogWindow.FooterContent><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsIdle}"><ctrls:Button Content="_Create" Kind="Accent" MinWidth="100" IsDefault="True" Click="OnCreate"/><ctrls:Button Content="Cancel" MinWidth="100" Margin="8,0,0,0" IsCancel="True"/></StackPanel></ctrls:DialogWindow.FooterContent>
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsIdle}"><StackPanel>
            <Label Content="_Location" Target="{Binding ElementName=Location}" Style="{StaticResource FieldLabel}"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ctrls:TextBox x:Name="Location" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/><ctrls:Button Grid.Column="1" Content="_Browse…" Margin="8,0,0,0" Click="OnBrowse"/></Grid>
            <Label Content="Project _name" Target="{Binding ElementName=ProjectName}" Style="{StaticResource FieldLabel}"/><ctrls:TextBox x:Name="ProjectName" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
            <Label Content="_Control name" Target="{Binding ElementName=ControlName}" Style="{StaticResource FieldLabel}"/><ctrls:TextBox x:Name="ControlName" Text="{Binding ControlName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
            <Label Content="_Namespace" Target="{Binding ElementName=Namespace}" Style="{StaticResource FieldLabel}"/><ctrls:TextBox x:Name="Namespace" Text="{Binding Namespace, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
            <Label Content="Template" Style="{StaticResource FieldLabel}"/><ctrls:ComboBox SelectedValue="{Binding Template}" SelectedValuePath="Tag" Margin="0,0,0,12"><ctrls:ComboBoxItem Content="Field" Tag="field"/><ctrls:ComboBoxItem Content="Dataset" Tag="dataset"/></ctrls:ComboBox>
            <Label Content="Framework" Style="{StaticResource FieldLabel}"/><ctrls:ComboBox SelectedValue="{Binding Framework}" SelectedValuePath="Tag" Margin="0,0,0,12"><ctrls:ComboBoxItem Content="None" Tag="none"/><ctrls:ComboBoxItem Content="React" Tag="react"/></ctrls:ComboBox>
            <ctrls:CheckBox Content="Install npm dependencies after scaffolding" IsChecked="{Binding InstallDependencies}"/>
            <ctrls:TextBlock Text="If creation fails or is canceled, generated files remain in the project folder." TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel></ScrollViewer>
        <ScrollViewer Grid.Row="1" MaxHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><ctrls:TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></ScrollViewer>
    </Grid>
</ctrls:DialogWindow>
