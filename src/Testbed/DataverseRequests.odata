# Select your environment in the Xrm Tools toolbar.
# Relative URLs resolve against that environment's /api/data/v9.2/ root.
# Send Request authenticates at execution time; no tokens belong in this file.
@limit = 5

### Current user
GET /WhoAmI

### Account names
GET /accounts?$select=accountid,name&$top={{limit}}
Prefer: odata.include-annotations="*"

### Create a test account
# Only run create, retrieve and cleanup in a designated test environment.
# @name createAccount
POST /accounts
Content-Type: application/json
Prefer: return=representation

{"name":"Xrm Tools OData editor test"}

### Retrieve the test account
GET /accounts({{createAccount.response.body.$.accountid}})?$select=name

### Clean up the test account
DELETE /accounts({{createAccount.response.body.$.accountid}})

### Metadata
GET /EntityDefinitions?$select=LogicalName,DisplayName

### Test
GET https://services.odata.org/TripPinRESTierService/People

### POST TEST
PATCH /accounts(7a0ca9e2-a2b3-f111-aaab-7ced8d731d43)


{
  "name": "Test Account"
}